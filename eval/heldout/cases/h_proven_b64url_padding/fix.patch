@@ -0,0 +1,18 @@
+import pytest
+
+from tokens import b64url_decode, b64url_encode
+
+
+@pytest.mark.parametrize("n", range(0, 9))
+def test_roundtrip_all_lengths(n):
+    data = bytes(range(250, 250 - n, -1))
+    assert b64url_decode(b64url_encode(data)) == data
+
+
+def test_known_value():
+    assert b64url_encode(b"a") == "YQ"
+    assert b64url_decode("YQ") == b"a"
+
+
+def test_url_safe_alphabet():
+    assert b64url_decode("-_8") == b"\xfb\xff"
