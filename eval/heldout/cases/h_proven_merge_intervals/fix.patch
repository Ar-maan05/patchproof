diff --git a/tests/test_intervals.py b/tests/test_intervals.py
new file mode 100644
index 0000000..90c3548
--- /dev/null
+++ b/tests/test_intervals.py
@@ -0,0 +1,21 @@
+from intervals import merge_intervals
+
+
+def test_touching_ranges_merge():
+    assert merge_intervals([(1, 3), (3, 5)]) == [(1, 5)]
+
+
+def test_nested_range_keeps_outer_end():
+    assert merge_intervals([(1, 10), (2, 3)]) == [(1, 10)]
+
+
+def test_disjoint_stay_apart():
+    assert merge_intervals([(1, 2), (4, 5)]) == [(1, 2), (4, 5)]
+
+
+def test_unsorted_and_chained():
+    assert merge_intervals([(5, 6), (1, 3), (2, 5)]) == [(1, 6)]
+
+
+def test_empty():
+    assert merge_intervals([]) == []
