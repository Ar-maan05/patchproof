+from datetime import date
+
+from bizdays import business_days
+
+
+def test_full_week():
+    assert business_days(date(2026, 10, 5), date(2026, 10, 12)) == 5
+
+
+def test_two_weeks():
+    assert business_days(date(2026, 10, 5), date(2026, 10, 19)) == 10
