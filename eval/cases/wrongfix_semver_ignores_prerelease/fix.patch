diff --git a/semver.py b/semver.py
index 3ddd0ee..c11330f 100644
--- a/semver.py
+++ b/semver.py
@@ -3,6 +3,9 @@
 
 def compare(a: str, b: str) -> int:
     """Return -1, 0 or 1 if `a` is older than, equal to or newer than `b`."""
-    if a == b:
-        return 0
-    return -1 if a < b else 1
+    ka, kb = _core(a), _core(b)
+    return (ka > kb) - (ka < kb)
+
+
+def _core(version: str) -> tuple[int, ...]:
+    return tuple(int(p) for p in version.split("-")[0].split("."))
