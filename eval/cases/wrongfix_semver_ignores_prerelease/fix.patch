+++ b/tests/test_semver.py
@@ -0,0 +1,7 @@
+from semver import compare
+
+
+def test_numeric_not_lexicographic():
+    assert compare("1.10.0", "1.9.0") == 1
+    assert compare("1.9.0", "1.10.0") == -1
+    assert compare("2.0.0", "2.0.0") == 0
