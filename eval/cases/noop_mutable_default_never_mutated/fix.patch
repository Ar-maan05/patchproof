--- /dev/null
+++ b/tests/test_collector.py
@@ -0,0 +1,12 @@
+from collector import collect_tags
+
+
+def test_calls_are_independent():
+    assert collect_tags("a") == ["a"]
+    assert collect_tags("b") == ["b"]
+
+
+def test_accumulates_when_given():
+    first = collect_tags("a")
+    assert collect_tags("b", first) == ["a", "b"]
+    assert first == ["a"]
