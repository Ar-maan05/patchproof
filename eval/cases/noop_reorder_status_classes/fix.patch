@@ -0,0 +1,13 @@
+import pytest
+
+from httpclass import classify
+
+
+@pytest.mark.parametrize(
+    "status,label",
+    [(100, "informational"), (200, "success"), (204, "success"), (301, "redirect"),
+     (399, "redirect"), (400, "client_error"), (404, "client_error"), (499, "client_error"),
+     (500, "server_error"), (503, "server_error")],
+)
+def test_classes(status, label):
+    assert classify(status) == label
