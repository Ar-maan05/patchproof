+import pytest
+
+from summary import median
+
+
+def test_odd_length():
+    assert median([5, 1, 3]) == 3
+    assert median([7]) == 7
+
+
+def test_unsorted_input():
+    assert median([9, 2, 4, 8, 1]) == 4
+
+
+def test_empty():
+    with pytest.raises(ValueError):
+        median([])
