@@ -0,0 +1,27 @@
+import csv
+import io
+
+from csvfmt import format_row, quote_field
+
+
+def test_plain_untouched():
+    assert quote_field("abc") == "abc"
+
+
+def test_comma():
+    assert quote_field("a,b") == '"a,b"'
+
+
+def test_embedded_quote_is_doubled():
+    assert quote_field('say "hi"') == '"say ""hi"""'
+
+
+def test_newline_and_cr():
+    assert quote_field("a\nb") == '"a\nb"'
+    assert quote_field("a\rb") == '"a\rb"'
+
+
+def test_roundtrip():
+    fields = ["a", "b,c", 'say "hi"', "line1\nline2", "cr\rhere", ""]
+    row = format_row(fields)
+    assert list(csv.reader(io.StringIO(row)))[0] == fields
