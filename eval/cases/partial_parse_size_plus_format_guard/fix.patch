+++ b/tests/test_sizes.py
@@ -0,0 +1,21 @@
+import pytest
+
+from sizes import parse_size
+
+
+def test_uppercase_units():
+    assert parse_size("10KB") == 10240
+
+
+def test_lowercase_and_spacing():
+    assert parse_size("10kb") == 10240
+    assert parse_size("1.5 Mb") == 1572864
+
+
+def test_bare_number_is_bytes():
+    assert parse_size("512") == 512
+
+
+def test_garbage():
+    with pytest.raises(ValueError):
+        parse_size("ten")
