@@ -0,0 +1,23 @@
+from textwidth import display_width, ljust_display
+
+
+def test_ascii():
+    assert display_width("abc") == 3
+    assert display_width("") == 0
+
+
+def test_cjk_is_double_width():
+    assert display_width("日本語") == 6
+
+
+def test_fullwidth_latin():
+    assert display_width("ＡＢ") == 4
+
+
+def test_combining_mark_has_no_width():
+    assert display_width("e\u0301") == 1
+
+
+def test_ljust_uses_columns():
+    assert ljust_display("日本", 6) == "日本  "
+    assert ljust_display("ab", 4, ".") == "ab.."
