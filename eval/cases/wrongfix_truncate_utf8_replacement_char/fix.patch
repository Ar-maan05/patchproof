+from truncate import truncate_utf8
+
+
+def test_split_multibyte_does_not_raise():
+    out = truncate_utf8("日本語", 4)
+    assert out.startswith("日")
+
+
+def test_ascii_unchanged():
+    assert truncate_utf8("hello", 3) == "hel"
