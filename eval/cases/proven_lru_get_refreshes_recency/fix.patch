diff --git a/tests/test_lru.py b/tests/test_lru.py
new file mode 100644
index 0000000..dd8aa67
--- /dev/null
+++ b/tests/test_lru.py
@@ -0,0 +1,25 @@
+from lru import LRUCache
+
+
+def test_get_refreshes_recency():
+    c = LRUCache(2)
+    c.put("a", 1)
+    c.put("b", 2)
+    assert c.get("a") == 1
+    c.put("c", 3)
+    assert "a" in c
+    assert "b" not in c
+    assert "c" in c
+
+
+def test_untouched_eviction_order_is_fifo():
+    c = LRUCache(2)
+    c.put("a", 1)
+    c.put("b", 2)
+    c.put("c", 3)
+    assert "a" not in c
+    assert len(c) == 2
+
+
+def test_missing_key_default():
+    assert LRUCache(1).get("x", "dflt") == "dflt"
