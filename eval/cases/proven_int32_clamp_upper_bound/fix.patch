+++ b/tests/test_intmath.py
@@ -0,0 +1,21 @@
+from intmath import add_saturating, clamp_int32
+
+
+def test_upper_saturation():
+    assert clamp_int32(2 ** 40) == 2147483647
+    assert clamp_int32(2147483647) == 2147483647
+    assert clamp_int32(2147483648) == 2147483647
+
+
+def test_lower_saturation():
+    assert clamp_int32(-2 ** 40) == -2147483648
+    assert clamp_int32(-2147483648) == -2147483648
+
+
+def test_passthrough():
+    assert clamp_int32(7) == 7
+
+
+def test_add_saturating():
+    assert add_saturating(2 ** 31 - 1, 1) == 2 ** 31 - 1
+    assert add_saturating(-5, 3) == -2
