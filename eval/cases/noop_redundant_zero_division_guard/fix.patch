index 0000000..e211c44
--- /dev/null
+++ b/tests/test_wstats.py
@@ -0,0 +1,20 @@
+import pytest
+
+from wstats import weighted_mean
+
+
+def test_basic():
+    assert weighted_mean([1, 3], [1, 1]) == 2
+
+
+def test_weights_matter():
+    assert weighted_mean([0, 10], [3, 1]) == 2.5
+
+
+def test_empty_is_zero():
+    assert weighted_mean([], []) == 0.0
+
+
+def test_zero_weight_rejected():
+    with pytest.raises(ValueError):
+        weighted_mean([1, 2], [0, 0])
