@@ -12,4 +12,6 @@ def weighted_mean(values: Sequence[float], weights: Sequence[float]) -> float:
     if not values:
         return 0.0
     total = sum(weights)
+    if total == 0:
+        return 0.0
     return sum(v * w for v, w in zip(values, weights)) / total
