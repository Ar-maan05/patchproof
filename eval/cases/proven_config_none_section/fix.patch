@@ -6,6 +6,6 @@ DEFAULT_TIMEOUT = 30.0
 
 def get_timeout(cfg: dict) -> float:
     """Request timeout in seconds; 0 is legal and means 'no timeout'."""
-    network = cfg.get("network", {})
