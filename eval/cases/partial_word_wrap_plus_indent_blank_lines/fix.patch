new file mode 100644
index 0000000..b7047bd
--- /dev/null
+++ b/tests/test_wrap.py
@@ -0,0 +1,15 @@
+from wrap import word_wrap
+
+
+def test_exact_fit_boundary():
+    assert word_wrap("the quick brown fox", 9) == ["the quick", "brown fox"]
+
+
+def test_space_counts_toward_width():
+    assert word_wrap("the quick brown fox", 8) == ["the", "quick", "brown", "fox"]
+
+
+def test_no_line_exceeds_width():
+    text = "pack my box with five dozen liquor jugs and then some more words"
+    for width in (7, 10, 13, 20):
+        assert all(len(line) <= width for line in word_wrap(text, width))
