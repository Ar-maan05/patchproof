--- /dev/null
+++ b/tests/test_slugs.py
@@ -0,0 +1,13 @@
+import pytest
+
+from slugs import is_valid_slug
+
+
+@pytest.mark.parametrize("slug", ["hello", "hello-world", "a1-b2-c3", "42"])
+def test_valid(slug):
+    assert is_valid_slug(slug)
+
+
+@pytest.mark.parametrize("slug", ["hello world", "hello-", "-hello", "a--b", "Hello", "", "a_b", "ok!"])
+def test_invalid(slug):
+    assert not is_valid_slug(slug)
